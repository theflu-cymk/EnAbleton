{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnAbleton song initiation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "song": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "folderName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+(?: [A-Za-z0-9_-]+)*$"
        },
        "onExists": {
          "enum": [
            "error",
            "reuse"
          ]
        },
        "subfolders": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "processes": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "process",
          "enabled",
          "params"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "process": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "params": {
            "type": "object"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "trackIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "clipIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hasMidi": {
                "type": "boolean"
              },
              "hasAudio": {
                "type": "boolean"
              },
              "minTracks": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failOn": {
          "enum": [
            "none",
            "info",
            "warning",
            "error"
          ]
        },
        "includeSession": {
          "type": "boolean"
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "error"
                ]
              },
              "params": {
                "type": "object"
              }
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trackIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "clipIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}